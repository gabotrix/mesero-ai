# ---------------------------------------------------------------- backend
PORT=8787

# Which agent pack to run. Only `mesero` ships in this repository.
PACK=mesero

# ----------------------------------------------------------- voice service
#
# The only thing you configure. Your venue key says which restaurant this is,
# and the voice, the carta, the tables and the agent all come with it.
#
# Leave it empty and the backend runs on the carta committed in
# backend/menu.json — enough to hear the whole thing work before you sign up for
# anything.
VENUE_KEY=

# Only if you point at your own deployment of the service.
# SUPABASE_PROJECT_REF=
# SUPABASE_BRIDGE_FUNCTION=gemini-live
# SUPABASE_ANON_KEY=

# ------------------------------------------------------------------- audio
# Sample rate the realtime model speaks. The device always speaks 16 kHz.
PROVIDER_RATE=24000

# ------------------------------------------------------------------ tables
# Development convenience: accept devices that present no token.
ALLOW_ANON_DEVICES=true

# Seconds a table keeps its order after the gadget drops off WiFi.
SESSION_GRACE_SECONDS=60

# ---------------------------------------------------------------- payments
# Payment links and WhatsApp go through the same Supabase project above, so
# the merchant and messaging keys never reach this machine either.
#
# Set to 0 to keep the backend from sending real WhatsApp messages while you
# are testing — every template message is billed.
WHATSAPP_SEND=1

# A WhatsApp receipt needs a template Meta has approved for YOUR business.
# Empty means receipts are skipped and the reason is logged.
WHATSAPP_RECEIPT_TEMPLATE=
