# ---------------------------------------------------------------- backend
PORT=8787

# Which agent pack to run. Only `mesero` ships in this repository.
PACK=mesero

# ----------------------------------------------------------- voice service
#
# Three ways to give this a voice. See docs/voz-local.md.
#
#   gabotrix  (default) paste a venue key and you are done
#   openai              your own credential, straight to OpenAI
#   local               a model on your own hardware, works without internet
#
PROVIDER=gabotrix

# --- PROVIDER=gabotrix -----------------------------------------------------
# The only thing you configure. Your venue key says which restaurant this is,
# and the voice, the carta, the tables and the agent all come with it. Leave it
# empty to run on the carta committed in backend/menu.json.
VENUE_KEY=

# --- PROVIDER=openai -------------------------------------------------------
# Note this puts a vendor key on this machine, which is what the hosted path
# exists to avoid. That trade is the point: you choose who holds the secret.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime

# --- PROVIDER=local --------------------------------------------------------
# Anything that speaks the envelope in docs/voz-local.md — whisper.cpp plus a
# small model plus Piper is a common answer.
LOCAL_VOICE_URL=ws://recomputer.local:8080/voice
# LOCAL_VOICE_TOKEN=

# Only if you point at your own deployment of the hosted service.
# SUPABASE_PROJECT_REF=
# SUPABASE_BRIDGE_FUNCTION=gemini-live
# SUPABASE_ANON_KEY=

# ------------------------------------------------------------------- audio
# Sample rate the realtime model speaks. The device always speaks 16 kHz.
PROVIDER_RATE=24000

# ------------------------------------------------------------------ tables
# Seconds a table keeps its order after the gadget drops off WiFi.
SESSION_GRACE_SECONDS=60

# ---------------------------------------------------------------- payments
# Payment links and WhatsApp go through the same Supabase project above, so
# the merchant and messaging keys never reach this machine either.
#
# Set to 0 to keep the backend from sending real WhatsApp messages while you
# are testing — every template message is billed.
WHATSAPP_SEND=1

# A WhatsApp receipt needs a template Meta has approved for YOUR business.
# Empty means receipts are skipped and the reason is logged.
WHATSAPP_RECEIPT_TEMPLATE=

# ------------------------------------------------------- tuning the room
# Every value below has a working default. You only reach for them when the
# room fights you — and in a restaurant, it will. They are listed here
# because a project that claims to be replicable and then hides its tuning
# knobs is not replicable; it is a demo that happened to work once.

# --- who is speaking -------------------------------------------------------
# Two voices closer together than this are treated as one person. Lower it
# for a crowded table, raise it if one diner keeps splitting into two.
SEAT_MERGE_DEGREES=26

# Frames of speech needed before a bearing is trusted at all.
BEARING_MIN_SAMPLES=10

# How much those frames must agree, 0..1 — the mean resultant length. Below
# this the turn is left unattributed rather than guessed. Lower it if dishes
# go unattributed too often; raise it if they land on the wrong person.
# Raising is the safer direction: nobody minds an unnamed dish as much as
# they mind one they have to hand across the table.
BEARING_MIN_STRENGTH=0.85

# Frames kept while estimating. A long window spans a change of speaker and
# averages two people into the empty space between them.
BEARING_WINDOW=30

# --- turn taking -----------------------------------------------------------
# Frames of speech over the agent before it stops talking. Lower interrupts
# more eagerly; raise it if a cough or a passing waiter cuts the agent off.
# While the agent is speaking, the array's own detector decides on its own —
# it runs after echo cancellation, so it does not hear the agent.
BARGE_IN_FRAMES=3

# Only used in the moment right after the agent stops, where residual echo can
# still trip the detector. Raise it if the agent interrupts itself on its own
# decay; it has no effect while the agent is mid-sentence.
BARGE_IN_LEVEL=1200

# Milliseconds of quiet that end a turn, and the level that counts as quiet.
VAD_SILENCE_MS=700
VAD_THRESHOLD=700

# Frames of speech needed to wake a sleeping table.
WAKE_VAD_FRAMES=6

# Milliseconds after the agent stops before the microphone is believed
# again — stops the speaker's own tail being heard as a customer.
ECHO_GUARD_MS=250

# --- audio -----------------------------------------------------------------
# Frames buffered before playback starts. Raise it on flaky WiFi to trade a
# little latency for an agent that does not stutter mid-sentence.
PRIME_FRAMES=10

# Milliseconds slept between served frames, pacing playback to real time.
SERVE_SLEEP_MS=20

# Milliseconds of silence held open before the table is considered idle.
SILENCE_HOLD_MS=400

# --- paths and service -----------------------------------------------------
# Where the backend looks for web/ and menu.json. Set only when running from
# a single-file build that lives apart from the repository.
MESERO_ROOT=

# The hosted voice service this backend talks to when PROVIDER=gabotrix.
# Not a credential — it is an address, the way api.openai.com is. Your venue
# key is what identifies you to it. Change these only if you are running your
# own service; see docs/service-api.md for the contract it has to speak.
SUPABASE_PROJECT_REF=
SUPABASE_BRIDGE_FUNCTION=
# Only for a self-hosted service that puts a gateway in front of its
# functions. The hosted one needs nothing here.
SUPABASE_ANON_KEY=

# Only read when PROVIDER=openai / PROVIDER=local.
OPENAI_REALTIME_URL=
LOCAL_VOICE_TOKEN=
