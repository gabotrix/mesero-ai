# Copy to .env next to docker-compose.yml.

# The only thing you have to set: which restaurant this deployment serves.
VENUE_KEY=

# Off in production. This backend has a public address, and a gadget that
# presents no token should not be handed a table.
ALLOW_ANON_DEVICES=false

PACK=mesero
SESSION_GRACE_SECONDS=60

# Every WhatsApp template message is billed. Set to 0 while testing.
WHATSAPP_SEND=1
WHATSAPP_RECEIPT_TEMPLATE=
